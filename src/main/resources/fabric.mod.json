{
	"schemaVersion": 1,
	"id": "screenshot-path",
	"version": "${version}",
	"name": "Screenshot Path",
	"description": "Redirects Minecraft ingame screenshots (F2) to your specified location.",
	"authors": [
		"karlsson1000"
	],
	"license": "MIT",
	"icon": "assets/screenshot-path/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.stellarmc.ScreenshotPath"
		]
	},
	"mixins": [
		"screenshot-path.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": ">=26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}